# Where the database is. On your computer: the embedded PostgreSQL the server starts itself.
# On the VPS: your PostgreSQL (docker-compose.yml sets this for you) and EMBEDDED_POSTGRES=false.
# On Vercel: set in the project's Environment Variables (the Neon integration adds DATABASE_URL itself).
DATABASE_URL="postgresql://yieldfield:change-me-database-password@127.0.0.1:5433/yieldfield?schema=public"
EMBEDDED_POSTGRES=true

# Signs the access tokens (JWT). Long and random; changing it signs everyone out.
JWT_SECRET="change-me-jwt-secret"
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

PORT=3000
HOST=0.0.0.0
