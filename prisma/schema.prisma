// Diana's farm: players, their sign-ins, their farms (the game's whole save plus the
// numbers the site shows), the animals on each farm and what happened there.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(cuid())
  username        String        @unique
  /// Null for accounts made by signing in with a wallet (no email, no password).
  email           String?       @unique
  passwordHash    String?
  createdAt       DateTime      @default(now())
  lastLoginAt     DateTime?
  /// Who they play: "Diana" or "Arash", chosen at sign-up (changing it costs BLOOM). Null on accounts from before.
  character       String?
  /// Can open /admin (so can the names in ADMIN_USERNAMES).
  isAdmin         Boolean       @default(false)
  /// Reputation the admins gave (and what tasks gave before 1.6); linked wallets, Discord and VIP add to it
  /// as they're worked out (src/lib/reputation.ts: the sources, tiers and what each allows).
  reputation      Int           @default(0)
  /// VIP until then (bought with BLOOM, or given by an admin); null or past: not VIP.
  vipUntil        DateTime?
  /// The money that comes from outside (crypto packs, wallet deposits, admins): VIP, the partner, gems, trading. Only the server changes it.
  bloom           Int           @default(0)
  /// Speed-ups (bought with BLOOM, won with the daily tasks). Only the server changes it.
  gems            Int           @default(0)
  /// The Discord account linked to the farm (OAuth, scope identify): one farm each.
  discordId       String?       @unique
  discordName     String?
  discordAvatar   String?
  discordLinkedAt DateTime?
  farm            Farm?
  sessions        Session[]
  events          FarmEvent[]
  payments        Payment[]
  wallets         Wallet[]
  dailyTasks      DailyTasks[]
  taskClaims      TaskClaim[]
  currencyLog     CurrencyLog[]
  sales           Listing[]     @relation("sales")
  purchases       Listing[]     @relation("purchases")
  /// Who invited them (their link, domain/ref=name, or the name typed at sign-up) and when (src/lib/referrals.ts).
  referredById    String?
  referredBy      User?         @relation("referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]        @relation("referrals")
  referredAt      DateTime?
  /// When their inviter got the coins for them (once they played a little); null before, and for invitees past the rewarded number.
  referralCoinsAt DateTime?
  /// When they first bought VIP themselves (VIP given by an admin doesn't count): their inviter's BLOOM counts these.
  vipBoughtAt     DateTime?
  /// Groups of VIP buyers among their invitees already paid in BLOOM.
  referralBloomGroups Int       @default(0)
  referralRewards ReferralReward[]
  /// The X (Twitter) account linked by OAuth 2.0: one farm each; its picture goes on the player's share card.
  xId             String?       @unique
  xUsername       String?
  xName           String?
  xAvatar         String?
  xLinkedAt       DateTime?
  xClaims         XTaskClaim[]
  /// Their farms on the world map: the home farm and the farms out there (src/lib/map/world.ts).
  mapFarms        MapFarm[]
  battles         Battle[]

  @@index([referredById])
}

/**
 * A farm on the world map (src/lib/map/world.ts): a player's home farm ("home", the one they play in, safe),
 * a farm of theirs out on the map ("outpost": built or taken, it gathers coins and produce for them), or a
 * bandits' farm ("wild", taken or raided by anyone). Each has its own name and square.
 */
model MapFarm {
  id          String    @id @default(cuid())
  kind        String
  /// The player it belongs to (null: the bandits', or a deleted player's, left to anyone).
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name        String
  /// The name in lower case: names are one of a kind.
  nameKey     String    @unique
  x           Int
  y           Int
  biome       String
  /// The bandits' strength (wild farms), 1 and up.
  tier        Int       @default(1)
  /// What it had gathered at storedAt (coins, and produce by item); it gathers more by the hour up to its store.
  coins       Int       @default(0)
  produce     Json      @default("{}")
  storedAt    DateTime  @default(now())
  /// Nobody may attack it until then (just raided, taken or built).
  shieldUntil DateTime?
  /// When it changed hands last.
  takenAt     DateTime?
  createdAt   DateTime  @default(now())

  @@unique([x, y])
  @@index([ownerId])
}

/** A part of the map (16 x 16 squares) whose bandits' farms have been put down already. */
model MapChunk {
  cx        Int
  cy        Int
  createdAt DateTime @default(now())

  @@id([cx, cy])
}

/** An attack on a farm: the fight, round by round (worked out here, played back in the game), and what the winner chose. */
model Battle {
  id         String    @id @default(cuid())
  attackerId String
  attacker   User      @relation(fields: [attackerId], references: [id], onDelete: Cascade)
  farmId     String
  /// The farm's owner when attacked (null: bandits).
  defenderId String?
  win        Boolean
  /// Both sides as they fought ({ attacker, defender: { name, power, health, character } }) and the rounds:
  /// [{ a: attacker's damage, ac: a critical, d: defender's damage, dc, ha: attacker's health after, hd: defender's }]
  log        Json
  /// "plunder" or "capture" (a won battle, once chosen), and what it brought.
  choice     String?
  loot       Json?
  /// A win must be acted on by then.
  expiresAt  DateTime
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
  @@index([farmId, createdAt])
}

/// A reward for inviting players: coins for an invitee who played a little, BLOOM for each group of invitees who bought VIP.
model ReferralReward {
  id        String   @id @default(cuid())
  /// The inviter.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "coins" or "bloom".
  kind      String
  amount    Int
  /// Coins: the invitee it was for. BLOOM: how many VIP invitees it counts up to (in note).
  inviteeId String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A task on X done and paid (coins): linking the account, following the game's page, liking its post, posting the share card.
model XTaskClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "connect", "follow", "like" or "share".
  task      String
  /// What it was for: the page's id (follow), the post's id (like), "" (connect, share).
  target    String   @default("")
  /// The X account that did it (one X account is paid once for each task, whichever farm it's linked to).
  xId       String
  coins     Int
  /// The player's post (share).
  proof     String?
  createdAt DateTime @default(now())

  @@unique([userId, task, target])
  @@index([xId, task, target])
}

/// A sign-in on one device: the refresh token (stored hashed) that keeps it signed in.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  client    String // "game" or "web"
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  /// Replaced by a newer token (a refresh), rather than signed out: a retry with it soon after still works,
  /// since the answer to that refresh may never have reached the device (src/lib/auth.ts refreshTokens).
  rotatedAt DateTime?

  @@index([userId])
}

model Farm {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Goes up by one with every save.
  revision  Int      @default(0)
  day       Int      @default(1)
  coins     Int      @default(250)
  /// The game's save as it sent it (see src/lib/farm.ts); null until the first save.
  state     Json?
  /// BLOOM bought (or granted, or spent on the server) for this farm, all told; the game adds what's new
  /// to its coins and keeps how much it has added in state.creditsSeen.
  credits   Int      @default(0)
  animals   Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Kept in step with the save's animal list, so animals can be queried on their own.
model Animal {
  id            String   @id // the game's id for it
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  kind          String // Chicken, Sheep, Cow
  name          String
  boughtDay     Int
  lastMilkedDay Int      @default(0)
  lastShornDay  Int      @default(0)
  /// Experience: every 10 levels it gives one more of what it gives.
  xp            Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([farmId])
}

/// Something that happened on a farm (sold the harvest, bought a cow...), for the activity feed.
model FarmEvent {
  id        BigInt   @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  day       Int
  data      Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A pack (BLOOM or gems) bought with crypto, or a deposit from a linked wallet: the exact amount to send, and whether it came.
model Payment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack      String
  bloom     Int
  /// A gem pack's gems (then bloom is 0).
  gems      Int       @default(0)
  usdCents  Int
  /// The coin and chain paid with (src/lib/shop.ts NETWORKS), e.g. USDT_TRC20.
  network   String
  /// The exact amount to send (a decimal string) and the same in the coin's smallest units.
  amount    String
  units     String
  /// The wallet it goes to (the admin's, at the time of the order) and the coin's USD price then.
  address   String
  usdPrice  Float
  /// pending -> paid (credited) | expired | cancelled; "confirming": seen on a chain that needs a block first.
  status    String    @default("pending")
  txHash    String?   @unique
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  checkedAt DateTime?
  note      String?

  @@index([status, network])
  @@index([userId, createdAt])
}

/// Admin settings: the wallets payments go to, the packs on sale.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A crypto wallet the player proved is theirs (by signing a message): payments from it are theirs, and it signs them in.
model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// evm (BNB Chain, Ethereum...), tron or ton.
  chain     String
  /// evm: 0x... lower-case; tron: base58 T...; ton: raw 0:hex.
  address   String
  createdAt DateTime @default(now())

  @@unique([chain, address])
  @@index([userId])
}

/// Connecting a wallet (or Discord) from the game: the game makes a request, the player signs (or authorizes) on the website, the game asks until it's done.
model WalletRequest {
  /// The secret the game holds (in the link it opens).
  code      String    @id
  /// Short, shown in the game and on the page, to check they're the same request.
  short     String
  /// link (a wallet, to the signed-in player), login (with a wallet) or discord (link Discord).
  mode      String
  userId    String?
  nonce     String
  status    String    @default("pending")
  chain     String?
  address   String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// When the game collected its sign-in (a login request signs in once).
  usedAt    DateTime?
}

/// One player's daily tasks for one (UTC) day: made at the first look that day, from their farm then.
model DailyTasks {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD, UTC.
  day       String
  tasks     Json
  createdAt DateTime @default(now())

  @@id([userId, day])
}

/// A daily task's reward, taken once: the experience the game adds and the reputation added here.
model TaskClaim {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        String
  /// The task's id that day ("t0", "t1"...), or "all" for finishing them all.
  taskId     String
  xp         Int
  reputation Int
  createdAt  DateTime @default(now())

  @@unique([userId, day, taskId])
  @@index([userId, createdAt])
}

/// Every change to a player's BLOOM or gems, with why: the books.
model CurrencyLog {
  id        BigInt   @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// bloom or gems
  currency  String
  change    Int
  /// The balance after it.
  balance   Int
  reason    String
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Something a player put up for sale on the market (src/lib/market.ts), held by the server until it's
/// sold (the BLOOM goes to the seller), taken back, or runs out (back to the seller's farm).
model Listing {
  id        String    @id @default(cuid())
  sellerId  String
  seller    User      @relation("sales", fields: [sellerId], references: [id], onDelete: Cascade)
  /// item (a crop or a product, several) or animal (one)
  kind      String
  /// The item's id (Wheat, Egg...) or the animal's kind (Chicken, Sheep, Cow).
  item      String
  /// What the price rule compares: the item's id, or the animal's kind and level band ("Cow@1": levels 10-19).
  key       String
  count     Int
  /// BLOOM for all of it, and for one (what's sorted and compared).
  price     Int
  unit      Float
  /// The animal as it was on the farm (name, experience...).
  animal    Json?
  /// active -> sold | cancelled | expired (given back)
  status    String    @default("active")
  createdAt DateTime  @default(now())
  expiresAt DateTime
  buyerId   String?
  buyer     User?     @relation("purchases", fields: [buyerId], references: [id], onDelete: SetNull)
  soldAt    DateTime?
  closedAt  DateTime?

  @@index([status, key, unit])
  @@index([sellerId, status])
  @@index([buyerId])
}

/// Something an admin sets to happen on every farm for a while (/admin/events, src/lib/events.ts): kind "wolf",
/// a wolf loose on the farms, going for each farmer as soon as they're in the game.
model GameEvent {
  id          String    @id @default(cuid())
  kind        String
  /// Its title, shown to the players (the game's badge, the site's banner).
  name        String    @default("The Black Wolf")
  startsAt    DateTime
  endsAt      DateTime
  /// The wolf's power (health a bite takes off a farmer) and its health on each farm.
  power       Int
  health      Int
  note        String?
  /// The admin who set it.
  createdBy   String
  createdAt   DateTime  @default(now())
  /// Called off (or ended early: then endsAt is moved instead).
  cancelledAt DateTime?

  @@index([kind, startsAt])
}

/// A version of the game players can update to from inside it (/admin/updates): the newest one not
/// withdrawn is offered to every copy older than it.
model AppRelease {
  id          String    @id @default(cuid())
  /// "android" (the only one the game updates itself on, for now).
  platform    String    @default("android")
  /// The APK's versionCode (Project Settings > Android > Store Version): newer means bigger.
  versionCode Int
  /// What the players see: "1.13".
  versionName String
  /// "What's new", shown in the game's update window.
  notes       String?
  /// Where the file is downloaded from: an address of its own, or /downloads/<file> on this server.
  url         String
  /// Bytes, for the download's progress.
  size        Int?
  /// "link" (somewhere else), "blob" (Vercel Blob) or "disk" (this server's releases folder).
  storage     String    @default("link")
  /// Players must update before they can play on.
  mandatory   Boolean   @default(false)
  /// Patches to it from earlier versions (Scripts/make_update_delta.py), [{ from, url, size }]: a copy of
  /// one of those versions downloads only what changed, else the whole APK.
  deltas      Json      @default("[]")
  /// Its content packs (on-demand looks and characters, cooked apart: Scripts/content_packs.py),
  /// [{ chunk, files: [{ name, size, sha1, url }] }]: the game downloads each when it first needs it.
  contentPacks Json     @default("[]")
  createdBy   String
  createdAt   DateTime  @default(now())
  /// Taken back: no longer offered (the one before it is, if any).
  withdrawnAt DateTime?

  @@index([platform, versionCode])
}
