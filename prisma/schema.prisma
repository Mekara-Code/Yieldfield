// Diana's farm: players, their sign-ins, their farms (the game's whole save plus the
// numbers the site shows), the animals on each farm and what happened there.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  /// Null for accounts made by signing in with a wallet (no email, no password).
  email        String?     @unique
  passwordHash String?
  createdAt    DateTime    @default(now())
  lastLoginAt  DateTime?
  /// Who they play: "Diana" or "Arash", chosen at sign-up (changing it costs BLOOM). Null on accounts from before.
  character    String?
  /// Can open /admin (so can the names in ADMIN_USERNAMES).
  isAdmin      Boolean     @default(false)
  farm         Farm?
  sessions     Session[]
  events       FarmEvent[]
  payments     Payment[]
  wallets      Wallet[]
}

/// A sign-in on one device: the refresh token (stored hashed) that keeps it signed in.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  client    String // "game" or "web"
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Farm {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Goes up by one with every save.
  revision  Int      @default(0)
  day       Int      @default(1)
  coins     Int      @default(250)
  /// The game's save as it sent it (see src/lib/farm.ts); null until the first save.
  state     Json?
  /// BLOOM bought (or granted, or spent on the server) for this farm, all told; the game adds what's new
  /// to its coins and keeps how much it has added in state.creditsSeen.
  credits   Int      @default(0)
  animals   Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Kept in step with the save's animal list, so animals can be queried on their own.
model Animal {
  id           String   @id // the game's id for it
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  kind         String // Chicken, Sheep, Cow
  name         String
  boughtDay    Int
  lastMilkedDay Int     @default(0)
  lastShornDay Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([farmId])
}

/// Something that happened on a farm (sold the harvest, bought a cow...), for the activity feed.
model FarmEvent {
  id        BigInt   @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  day       Int
  data      Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A BLOOM pack bought with crypto: the exact amount to send to the wallet, and whether it came.
model Payment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack       String
  bloom      Int
  usdCents   Int
  /// The coin and chain paid with (src/lib/shop.ts NETWORKS), e.g. USDT_TRC20.
  network    String
  /// The exact amount to send (a decimal string) and the same in the coin's smallest units.
  amount     String
  units      String
  /// The wallet it goes to (the admin's, at the time of the order) and the coin's USD price then.
  address    String
  usdPrice   Float
  /// pending -> paid (credited) | expired | cancelled; "confirming": seen on a chain that needs a block first.
  status     String    @default("pending")
  txHash     String?   @unique
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  checkedAt  DateTime?
  note       String?

  @@index([status, network])
  @@index([userId, createdAt])
}

/// Admin settings: the wallets payments go to, the packs on sale.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A crypto wallet the player proved is theirs (by signing a message): payments from it are theirs, and it signs them in.
model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// evm (BNB Chain, Ethereum...), tron or ton.
  chain     String
  /// evm: 0x... lower-case; tron: base58 T...; ton: raw 0:hex.
  address   String
  createdAt DateTime @default(now())

  @@unique([chain, address])
  @@index([userId])
}

/// Connecting a wallet from the game: the game makes a request, the player signs on the website, the game asks until it's done.
model WalletRequest {
  /// The secret the game holds (in the link it opens).
  code      String    @id
  /// Short, shown in the game and on the page, to check they're the same request.
  short     String
  /// link (to the signed-in player) or login.
  mode      String
  userId    String?
  nonce     String
  status    String    @default("pending")
  chain     String?
  address   String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// When the game collected its sign-in (a login request signs in once).
  usedAt    DateTime?
}
